# RideFlow Analytics Platform - Environment Configuration
# Copy to .env and adjust values. Never commit .env with real credentials.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rideflow
POSTGRES_USER=rideflow
POSTGRES_PASSWORD=rideflow_secret

# Dataset sizes (defaults are development-friendly; scale up for full demo)
# Full production-style targets: USERS=100000 DRIVERS=20000 RIDES=3000000
NUM_USERS=10000
NUM_DRIVERS=2000
NUM_VEHICLES=2200
NUM_CITIES=10
NUM_ZONES=100
NUM_RIDES=100000
NUM_DRIVER_SESSIONS=50000
NUM_PROMOTIONS=50

# Data generation
RANDOM_SEED=42
DATA_START_DATE=2024-01-01
DATA_END_DATE=2025-12-31
DQ_ISSUE_RATE=0.002

# Anomaly detection
ANOMALY_ZSCORE_THRESHOLD=3.0
ANOMALY_ISOLATION_FOREST=true

# Paths
DATA_SOURCE_DIR=data/source
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rideflow:rideflow_secret@postgres:5432/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# dbt
DBT_PROFILES_DIR=dbt
DBT_TARGET=dev

# Pipeline
BATCH_SIZE=10000
FARE_TOLERANCE=0.05
